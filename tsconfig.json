{
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "node",
    "target": "esnext",
    "inlineSourceMap": true,
    "rootDir": "./src",
    "paths": {
      "NS": ["./custom-types/NetscriptDefinitions"],
      "BB": ["./custom-types/MyTypes"]
    },
    "typeRoots": [
      "./custom-types/NetscriptDefinitions",
      "./custom-type/MyTypes"
    ],
    "allowJs": true,
    "checkJs": false,
    "lib": ["ES2019", "DOM"]
  }
}
